# Copy to .env and fill in real values before running `docker compose up`.

# Contents of config/master.key (required to boot in RAILS_ENV=production).
RAILS_MASTER_KEY=

# URL of the application under test. Defaults to a public demo site
# (the-internet.herokuapp.com) when unset, so the app works out of the box.
SAMPLE_EXTERNAL_APP_URL=https://the-internet.herokuapp.com

# opencode API key. If set, the container writes it into
# ~/.local/share/opencode/auth.json on boot, so `opencode` is authenticated
# automatically. If unset, run `docker compose exec web opencode auth login`
# instead.
OPENCODE_API_KEY=
